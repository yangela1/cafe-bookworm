// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Cafe {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  address       String
  city          City
  siteURL       String?
  hours         String?

  googlePlaceId String?  @unique
  mapsUrl       String?
  latitude      Float?
  longitude     Float?

  reviews       Review[]
  images        Image[]
  tags          Tag[]    @relation("CafeTags")
}

model Review {
  id            String   @id @default(cuid())
  cafeId        String
  cafe          Cafe     @relation(fields: [cafeId], references: [id])
  
  order         String   
  pricePoint    Int      
  dateVisited   DateTime
  thoughts      String
  recommended   Boolean
  rating        Int
  favourite     Boolean  @default(false)
}

model Image {
  id            String   @id @default(cuid())
  url           String   
  cafeId        String
  cafe          Cafe     @relation(fields: [cafeId], references: [id])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  cafes Cafe[] @relation("CafeTags")
}

// All 21 Metro Vancouver municipalities. Listed up front so importing a cafe
// in a new city never needs another migration — unused values cost nothing.
enum City {
  Vancouver
  Burnaby
  Richmond
  Surrey
  Coquitlam
  NorthVancouver @map("North Vancouver")
  WestVancouver  @map("West Vancouver")
  NewWestminster @map("New Westminster")
  PortCoquitlam  @map("Port Coquitlam")
  PortMoody      @map("Port Moody")
  Delta
  Langley
  MapleRidge     @map("Maple Ridge")
  PittMeadows    @map("Pitt Meadows")
  WhiteRock      @map("White Rock")
  BowenIsland    @map("Bowen Island")
  Anmore
  Belcarra
  LionsBay       @map("Lions Bay")
}
